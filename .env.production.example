# =============================================================================
# Production (AWS EC2) – /opt/jiraffe/.env
# =============================================================================
# Copy this file and replace all placeholder values.
# NEVER commit the real .env file.
# =============================================================================

# Application
NEXTAUTH_SECRET=<run: openssl rand -base64 32>
NEXTAUTH_URL=https://jiraffe.xyz

# MongoDB (leave unset to use local Docker MongoDB)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/swe5006

# SonarQube PostgreSQL
SONAR_JDBC_PASSWORD=<any strong password>

# Docker image (auto-updated by CI/CD)
APP_IMAGE=ghcr.io/marcusohx/swe5006-jiraffe:latest

# GitHub PAT for pulling private GHCR images
# Create at: https://github.com/settings/tokens (classic, scopes: repo + read:packages)
GH_PAT=ghp_<your token>
GH_USERNAME=marcusohx
